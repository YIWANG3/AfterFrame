# ExifTool config (Perl) for the sidecar's -stay_open processes
# (media_workspace/exiftool.py).
#
# At the end of its input a -stay_open ExifTool keeps polling for more
# instead of exiting, so a sidecar that is killed or crashes would leave it
# running for good. Every 2 s it checks that its parent is still the
# sidecar, whose process id is in AFTERFRAME_EXIFTOOL_PARENT: an orphan is
# handed to another parent. macOS and Linux only; on Windows, where Perl's
# alarm doesn't fire here, a job object ends it with the sidecar.
my $parent = $ENV{AFTERFRAME_EXIFTOOL_PARENT};
if ($parent) {
    $SIG{ALRM} = sub {
        exit 0 if getppid() != $parent;
        alarm 2;
    };
    alarm 2;
}
1;  # a config file returns true
